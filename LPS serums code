> file <-read_excel("/Users/eaintsu/Downloads/20261002_LPSResults_Kyle.xlsx", sheet= "Sheet3")
myft <- file %>% 
+     
+     mutate(
+         Group = case_when(
+             Age > 0  & Age <= 30 ~ "0-30",
+             Age > 30 & Age <= 60 ~ "31-60",
+             Age > 60 & Age <= 90 ~ "61-90",
+             Age > 90 & Age <=120 ~ "91 and above"
+             
+         )
+     )  %>%
+     mutate(Sex = case_when(Sex == "Female" ~ "Female",
+                            Sex == "Male" ~ "Male")) %>%
+     
+     tbl_summary(by = Sex,    #by function splits into columns
+                 include = c(Group),
+                 statistic = list(all_categorical() ~ "{n} ({p}%)",
+                                  all_continuous() ~ "{mean} ({sd})"),
+                 digits = all_continuous() ~ 2,
+                 
+                 missing_text = "Missing") %>%
+     gtsummary::as_flex_table()
big_b <- fp_border_default(color = "black", width = 2) # adds black border
myft <- italic(myft, j = 1) # makes first column italic

    myft <- bg(myft, bg = "white", part = "header")
    myft <- fontsize(myft, part = "all", size = 14) #fontsize for all
    myft <- color(myft, color = "maroon", part = "header") #white text header
    myft <- border_outer(myft, big_b, part = "header") # add border for header
 myft <- border_outer(myft, big_b, part = "body")
 myft <- autofit(myft) #autoformat column height and width
 myft  # print out the table in the viewer
